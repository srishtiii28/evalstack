# Copy to .env and fill in. .env is git-ignored; this file is not.
#
#   cp .env.example .env

# Required for `evalforge run --agent model`.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults are conservative; raise them to match your account's
# published allowance, or lower them if you are sharing a key.
# EVALFORGE_REQUESTS_PER_MINUTE=25
# EVALFORGE_TOKENS_PER_MINUTE=90000

# Optional. Only needed on a billed account — a free tier really is zero, and an
# unknown rate is reported as untracked rather than as $0.00.
# EVALFORGE_MODEL_PRICING={"llama-3.3-70b-versatile": {"input": 0.59, "output": 0.79}}
